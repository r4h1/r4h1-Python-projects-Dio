import face_recognition
import os
import cv2
import numpy as np
from PIL import Image, ImageDraw, ImageFont
from google.colab.patches import cv2_imshow  # For displaying images in Colab
from IPython.display import Image, display #alternative image display

def load_known_faces(known_faces_dir):
    """Loads known celebrity faces and names from a directory."""
    known_faces = []
    known_names = []

    for filename in os.listdir(known_faces_dir):
        if filename.lower().endswith(('.png', '.jpg', '.jpeg')):
            image = face_recognition.load_image_file(os.path.join(known_faces_dir, filename))
            face_encodings = face_recognition.face_encodings(image)
            if len(face_encodings) > 0:
                known_faces.append(face_encodings[0])
                known_names.append(os.path.splitext(filename)[0])
            else:
                print(f"Warning: No face found in {filename}")

    return known_faces, known_names

def recognize_faces(image_path, known_faces, known_names):
    """Recognizes faces in an image using known faces."""
    image = face_recognition.load_image_file(image_path)
    face_locations = face_recognition.face_locations(image)
    face_encodings = face_recognition.face_encodings(image, face_locations)

    face_names = []
    for face_encoding in face_encodings:
        matches = face_recognition.compare_faces(known_faces, face_encoding)
        name = "Unknown"

        face_distances = face_recognition.face_distance(known_faces, face_encoding)
        best_match_index = np.argmin(face_distances)
        if matches[best_match_index]:
            name = known_names[best_match_index]

        face_names.append(name)

    return face_locations, face_names, image

def draw_face_boxes(image_path, face_locations, face_names):
    """Draws bounding boxes and names on detected faces."""
    image = Image.fromarray(cv2.cvtColor(cv2.imread(image_path), cv2.COLOR_BGR2RGB))
    draw = ImageDraw.Draw(image)
    try:
        font = ImageFont.truetype("arial.ttf", 36)
    except IOError:
        font = ImageFont.load_default()

    for (top, right, bottom, left), name in zip(face_locations, face_names):
        draw.rectangle(((left, top), (right, bottom)), outline=(0, 0, 255), width=2)
        text_width, text_height = draw.textsize(name, font=font)
        draw.rectangle(((left, bottom - text_height - 10), (right, bottom)), fill=(0, 0, 255), outline=(0, 0, 255))
        draw.text((left + 6, bottom - text_height - 5), name, fill=(255, 255, 255), font=font)

    cv2_imshow(cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)) #using cv2_imshow

    #Alternative method using IPython.display
    #image.save("result.jpg")
    #display(Image("result.jpg"))

def main():
    known_faces_dir = "known_faces"
    test_image_path = "test_image.jpg"

    if not os.path.exists(known_faces_dir):
        print(f"Error: Directory '{known_faces_dir}' not found. Please upload 'known_faces.zip' and unzip it.")
        return

    known_faces, known_names = load_known_faces(known_faces_dir)

    if not known_faces:
        print("Error: No known faces found. Please add images to the 'known_faces' directory.")
        return

    face_locations, face_names, image = recognize_faces(test_image_path, known_faces, known_names)
    draw_face_boxes(test_image_path, face_locations, face_names)

if __name__ == "__main__":
